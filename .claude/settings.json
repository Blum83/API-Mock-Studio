{
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(node server/index.js)",
      "Bash(curl -s http://localhost:8081/api/mocks)",
      "Bash(curl -s http://localhost:8081/api/requests)",
      "Bash(kill %1)",
      "Bash(netstat -ano)",
      "Bash(taskkill /PID 45280 /F)",
      "Bash(cmd /c \"taskkill /PID 45280 /F\")",
      "Bash(cmd /c \"taskkill /PID 45280 /F 2>&1\")",
      "Bash(powershell -Command \"Stop-Process -Id 45280 -Force -ErrorAction SilentlyContinue; Write-Host 'done'\")"
    ]
  }
}
