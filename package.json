{
  "name": "api-mock-studio",
  "version": "1.0.0",
  "description": "HTTP proxy + web UI for intercepting, inspecting, and mocking API responses",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node server/index.js",
    "dev:ui": "vite --config ui/vite.config.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:ui\"",
    "build": "vite build --config ui/vite.config.js",
    "electron:dev": "npm run build && electron .",
    "electron:hot": "concurrently -k \"node server/index.js\" \"vite --config ui/vite.config.js\" \"cross-env VITE_DEV=1 electron .\"",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "icons": "node scripts/generate-icons.js"
  },
  "build": {
    "appId": "com.blumination.api-mock-studio",
    "productName": "API Mock Studio",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "ui/dist/**/*",
      "config.js",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "lowdb": "^1.0.0",
    "micromatch": "^4.0.5",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "vite": "^4.5.3",
    "vue": "^3.3.8"
  }
}
